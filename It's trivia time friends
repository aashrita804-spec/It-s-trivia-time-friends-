<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Neon Junior Quiz</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--c:#00f0ff;--m:#ff2bd6;--g:#39ff14;--y:#ffe600;--t:#eaf6ff;color-scheme:dark}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:#05010f;color:var(--t);font-family:"Trebuchet MS",system-ui,sans-serif;min-height:100vh;overflow-x:hidden}
#st{position:fixed;inset:0;z-index:0}
.fog{position:fixed;inset:0;z-index:0;background:radial-gradient(circle at 20% 10%,#3b0a7a99,transparent 50%),radial-gradient(circle at 85% 30%,#00f0ff33,transparent 45%),radial-gradient(circle at 50% 100%,#ff2bd655,transparent 50%)}
.grid{position:fixed;left:-20%;right:-20%;bottom:0;height:42vh;z-index:0;background:linear-gradient(#ff2bd6aa 1px,transparent 1px),linear-gradient(90deg,#00f0ffaa 1px,transparent 1px);background-size:44px 44px;transform:perspective(260px) rotateX(62deg);transform-origin:bottom;animation:mv 1.6s linear infinite;-webkit-mask-image:linear-gradient(transparent,#000);mask-image:linear-gradient(transparent,#000)}
@keyframes mv{to{background-position:0 44px}}
.w{position:relative;z-index:1;max-width:560px;margin:0 auto;padding:14px}
h1{font-size:1.9rem;text-align:center;margin:4px 0 10px;color:#fff;letter-spacing:3px;animation:fl 4s infinite;text-shadow:0 0 4px #fff,0 0 12px var(--c),0 0 28px var(--c),0 0 56px var(--m)}
@keyframes fl{0%,18%,22%,60%,100%{opacity:1}20%,62%{opacity:.7}}
.bar{display:flex;justify-content:space-between;gap:8px;margin-bottom:10px}
.pill{display:flex;align-items:center;gap:6px;border:2px solid var(--m);border-radius:99px;padding:5px 12px;font-weight:700;font-size:.9rem;background:#12052e99;box-shadow:0 0 12px var(--m),inset 0 0 10px #ff2bd644}
.pill.dm{border-color:var(--c);box-shadow:0 0 12px var(--c),inset 0 0 10px #00f0ff44}
.pill svg{width:20px;height:20px;filter:drop-shadow(0 0 5px var(--c))}
.lad{display:flex;gap:4px;margin-bottom:10px}.lad i{flex:1;height:9px;border-radius:5px;background:#2a1b5e}
.lad i.d{background:var(--g);box-shadow:0 0 9px var(--g)}.lad i.n{background:var(--y);box-shadow:0 0 10px var(--y);animation:pu 1s infinite}
@keyframes pu{50%{opacity:.4}}
.row{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.sub{flex:1;color:var(--y);text-shadow:0 0 8px var(--y);font-weight:700;text-transform:uppercase;font-size:.78rem;letter-spacing:2px}
.sub b{display:block;font-size:1.25rem;color:#fff;text-shadow:0 0 10px var(--m),0 0 20px var(--m)}
.ring{position:relative;width:58px;height:58px}.ring svg{width:58px;height:58px;transform:rotate(-90deg)}
.ring span{position:absolute;inset:0;display:grid;place-items:center;font-weight:800;font-size:1.1rem}
.hx{filter:drop-shadow(0 0 7px var(--c)) drop-shadow(0 0 16px #00f0ff66)}
.hx>*{clip-path:polygon(3% 0,97% 0,100% 50%,97% 100%,3% 100%,0 50%)}
.q{padding:2px;background:linear-gradient(90deg,var(--c),var(--m))}
.q div{background:linear-gradient(#150a40,#0a0526);padding:22px 20px;font-size:1.2rem;text-align:center;line-height:1.35;clip-path:polygon(3% 0,97% 0,100% 50%,97% 100%,3% 100%,0 50%)}
#os{margin:12px 0 6px}
#os .hx{margin:9px 0;transition:.2s}
.o{display:block;width:100%;border:0;padding:2px;background:linear-gradient(90deg,var(--m),var(--c));cursor:pointer;font:inherit;color:var(--t)}
.o div{display:flex;gap:10px;align-items:center;text-align:left;padding:13px 22px;font-size:1.05rem;background:linear-gradient(#150a40,#0a0526);clip-path:polygon(3% 0,97% 0,100% 50%,97% 100%,3% 100%,0 50%)}
.o b{color:var(--y);text-shadow:0 0 8px var(--y)}
.o:active{filter:brightness(1.4)}
.hx.ok{filter:drop-shadow(0 0 12px var(--g)) drop-shadow(0 0 28px var(--g));transform:scale(1.03)}.hx.ok .o{background:var(--g)}.hx.ok .o div{background:#0b4a14}
.hx.no{filter:drop-shadow(0 0 12px #f33) drop-shadow(0 0 28px #f33);animation:sk .4s}.hx.no .o{background:#f33}.hx.no .o div{background:#4a0b0b}
.hx.gone{opacity:.12;pointer-events:none}
@keyframes sk{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.hint{margin:8px 0;padding:10px 12px;border-radius:10px;border:1px solid var(--y);background:#3a330022;color:#fff7a8;box-shadow:0 0 12px #ffe60055;text-shadow:0 0 6px #ffe60088}
.msg{min-height:1.4em;text-align:center;color:var(--y);text-shadow:0 0 8px var(--y);margin:6px 0}
.c{text-align:center}
.btn{border:2px solid var(--g);background:#0a2a0a55;color:var(--g);padding:13px 26px;border-radius:14px;font:700 1.05rem inherit;font-family:inherit;box-shadow:0 0 14px var(--g),inset 0 0 10px #39ff1444;text-shadow:0 0 8px var(--g);cursor:pointer;letter-spacing:1px}
.btn.y{border-color:var(--y);color:var(--y);background:#3a330033;box-shadow:0 0 14px var(--y),inset 0 0 10px #ffe60033;text-shadow:0 0 8px var(--y)}
.btn:disabled{opacity:.35}
.big{font-size:2.8rem;font-weight:800;color:var(--y);margin:12px 0;text-shadow:0 0 6px #fff,0 0 20px var(--y),0 0 44px var(--m)}
.logo{width:120px;height:120px;margin:10px auto;display:block;animation:fl2 3s ease-in-out infinite;filter:drop-shadow(0 0 14px var(--c)) drop-shadow(0 0 34px var(--m))}
@keyframes fl2{50%{transform:translateY(-8px) rotate(4deg)}}
.sp{width:46px;height:46px;border-radius:50%;border:4px solid #2a1b5e;border-top-color:var(--c);margin:18px auto;animation:rt .8s linear infinite;box-shadow:0 0 14px var(--c)}
@keyframes rt{to{transform:rotate(360deg)}}
.cf{position:fixed;top:-20px;width:10px;height:14px;z-index:9;pointer-events:none;animation:fa linear forwards}
@keyframes fa{to{transform:translateY(110vh) rotate(720deg)}}
.pop{position:fixed;left:50%;top:40%;z-index:10;font-size:2.4rem;font-weight:800;color:#fff;text-shadow:0 0 20px var(--c),0 0 40px var(--m);animation:pp 1.6s forwards;pointer-events:none;white-space:nowrap}
@keyframes pp{0%{transform:translate(-50%,0) scale(.5);opacity:0}20%{transform:translate(-50%,-20px) scale(1.2);opacity:1}100%{transform:translate(-50%,-90px) scale(1);opacity:0}}
</style></head><body>
<canvas id="st"></canvas><div class="fog"></div><div class="grid"></div>
<div class="w" id="app"></div>
<script>
// ---- starfield
const cv=document.getElementById("st"),cx=cv.getContext("2d");let SD=[];
function rs(){cv.width=innerWidth;cv.height=innerHeight;SD=Array.from({length:90},()=>({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*1.6+.3,p:Math.random()*6,c:["#00f0ff","#ff2bd6","#fff"][Math.random()*3|0]}))}
rs();addEventListener("resize",rs);
(function f(t){cx.clearRect(0,0,cv.width,cv.height);SD.forEach(s=>{cx.globalAlpha=.4+.6*Math.abs(Math.sin(t/900+s.p));cx.fillStyle=s.c;cx.shadowBlur=8;cx.shadowColor=s.c;cx.beginPath();cx.arc(s.x,s.y,s.r,0,7);cx.fill()});requestAnimationFrame(f)})(0);

// ---- fallback bank: [subject, question, correct, w1, w2, w3, hint]
const BANK=[
["Science","Which planet is called the Red Planet?","Mars","Venus","Jupiter","Saturn","Named after the Roman god of war."],
["Science","Which gas do plants take in for photosynthesis?","Carbon dioxide","Oxygen","Nitrogen","Hydrogen","Humans breathe this gas out."],
["Science","What is the chemical symbol for gold?","Au","Ag","Gd","Go","It comes from the Latin word aurum."],
["Science","Which part of the cell is the powerhouse?","Mitochondria","Nucleus","Ribosome","Vacuole","It makes the cell energy."],
["Science","Which is the largest mammal?","Blue whale","Elephant","Giraffe","Shark","It lives in the ocean."],
["History","Who was the first Prime Minister of India?","Jawaharlal Nehru","Sardar Patel","Mahatma Gandhi","Lal Bahadur Shastri","Children called him Chacha."],
["History","Who built the Taj Mahal?","Shah Jahan","Akbar","Babur","Aurangzeb","He built it for Mumtaz Mahal."],
["History","In which year did India become independent?","1947","1950","1942","1935","Mid-1940s, on 15 August."],
["History","Who wrote the Ramayana?","Valmiki","Vyasa","Tulsidas","Kalidasa","An ancient sage called Adi Kavi."],
["Geography","What is the capital of Japan?","Tokyo","Kyoto","Osaka","Beijing","The Land of the Rising Sun."],
["Geography","Which is the largest ocean?","Pacific","Atlantic","Indian","Arctic","It covers about a third of Earth."],
["Geography","Which continent has the most countries?","Africa","Asia","Europe","South America","The Sahara is here."],
["Geography","Which river is the longest in India?","Ganga","Yamuna","Godavari","Brahmaputra","Varanasi sits on its bank."],
["English","What is the plural of child?","Children","Childs","Childes","Childrens","An irregular plural."],
["English","Which word means the same as happy?","Joyful","Sad","Angry","Tired","Think of a big smile."],
["GK","Which is the national animal of India?","Tiger","Lion","Elephant","Leopard","Striped big cat."],
["GK","How many rings are in the Olympic symbol?","5","4","6","7","Count the colours: blue, yellow, black, green, red."],
["GK","Who invented the telephone?","Alexander Graham Bell","Edison","Newton","Marconi","A Scottish-born scientist."],
["GK","How many colours are in a rainbow?","7","5","6","8","VIBGYOR."],
["Sports","How many players are in a cricket team on the field?","11","9","10","12","Same as football."]
];
const R=n=>Math.random()*n|0;
const sh=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=R(i+1);[a[i],a[j]]=[a[j],a[i]]}return a};
function mathQ(){const a=2+R(18),b=2+R(12),t=R(4);let q,c,h;
 if(t==0){q=`${a} × ${b} = ?`;c=a*b;h=`Think of the ${b} times table.`}
 else if(t==1){q=`${a*b} ÷ ${b} = ?`;c=a;h=`What times ${b} makes ${a*b}?`}
 else if(t==2){const p=[10,20,25,50][R(4)],m=20*(1+R(10));q=`What is ${p}% of ${m}?`;c=p*m/100;h=`${p}% is ${100/p} parts out of 100 of the number.`}
 else{q=`${a}² = ?`;c=a*a;h=`${a} multiplied by itself.`}
 const ws=new Set();[1,-1,10,-10,2,-2,a,b].forEach(d=>{});
 [c+1,c-1,c+10,c-10,c+2,c-2,c+b,c+a].forEach(v=>{if(v>0&&v!==c&&ws.size<8)ws.add(v)});
 const w=sh([...ws]).slice(0,3);return["Maths",q,""+c,""+w[0],""+w[1],""+w[2],h]}

// ---- question supply (AI via sample, fallback to bank + generated maths)
const seen=[],queue=[];let busy=null,smp;
const ok=s=>typeof s==="string"&&s.length>0&&s.length<220;
async function aiBatch(){
 smp=smp||await (window.claude&&claude.use("sample"));
 if(!smp)throw 0;
 const p=`Create 10 NEW multiple-choice trivia questions for school kids (class 3 to 8), like KBC Junior. Mix subjects: Science, Maths, History, Geography, English, General Knowledge, Sports, Technology, Nature. Order from easy to harder. Facts must be correct and have exactly one right answer. Do NOT repeat or paraphrase any of these: ${JSON.stringify(seen.slice(-40))}. Return ONLY a JSON array of 10 objects: {"s":"subject","q":"question","c":"correct answer","w":["wrong1","wrong2","wrong3"],"h":"short hint that does not reveal the answer"}. Random seed: ${Math.random()}`;
 const v=await smp.json(p,{cache:false});
 return v.filter(x=>x&&ok(x.q)&&ok(x.c)&&Array.isArray(x.w)&&x.w.length>=3&&x.w.every(ok)&&ok(x.h)&&!seen.includes(x.q)).map(x=>[String(x.s||"GK").slice(0,20),x.q,x.c,x.w[0],x.w[1],x.w[2],x.h])}
function fb(){let un=BANK.filter(b=>!seen.includes(b[1]));if(un.length<3)un=BANK;const o=sh(un).slice(0,6);while(o.length<10)o.push(mathQ());return sh(o)}
async function fill(){if(busy)return busy;busy=(async()=>{let a=[];try{a=await aiBatch()}catch(e){}if(a.length<5)a=fb();a.forEach(x=>seen.push(x[1]));queue.push(...a)})();try{await busy}finally{busy=null}}
async function take(n){while(queue.length<n)await fill();return queue.splice(0,n)}

// ---- game
const P=[1000,2000,3000,5000,10000,20000,40000,80000,160000,1000000],SAFE=[4,9],T=30;
const L=(k,d)=>{try{const v=localStorage.getItem(k);return v===null?d:+v}catch(e){return d}};
const S=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
let tot=L("tc",0),spent=L("sp",0),g;
const dia=()=>Math.floor(tot/10)-spent;
const E=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const A=document.getElementById("app"),fmt=n=>"₹"+n.toLocaleString("en-IN");
const DM=`<svg viewBox="0 0 24 24"><defs><linearGradient id="dg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9ffcff"/><stop offset="1" stop-color="#ff2bd6"/></linearGradient></defs><path d="M6 3h12l4 6-10 12L2 9z" fill="url(#dg)" stroke="#fff" stroke-width="1"/><path d="M2 9h20M9 3l-2 6 5 12 5-12-2-6" fill="none" stroke="#fff" stroke-width=".7" opacity=".7"/></svg>`;
const head=()=>`<h1>NEON JUNIOR QUIZ</h1><div class="bar"><span class="pill dm" id="dc">${DM}${dia()}</span><span class="pill" id="pr">Next 💎 ${tot%10}/10</span></div>`;
function upd(){document.getElementById("dc").innerHTML=DM+dia();document.getElementById("pr").textContent="Next 💎 "+tot%10+"/10"}
function boom(n=60){const cs=["#00f0ff","#ff2bd6","#39ff14","#ffe600","#fff"];for(let i=0;i<n;i++){const d=document.createElement("div");d.className="cf";d.style.cssText=`left:${R(100)}vw;background:${cs[R(5)]};box-shadow:0 0 8px ${cs[R(5)]};animation-duration:${1.6+Math.random()*1.6}s;animation-delay:${Math.random()*.4}s`;document.body.appendChild(d);setTimeout(()=>d.remove(),4000)}}
function pop(t){const d=document.createElement("div");d.className="pop";d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),1700)}
function home(){clearInterval(g&&g.tm);A.innerHTML=head()+`<div class="c"><svg class="logo" viewBox="0 0 24 24"><use href="#none"/><path d="M6 3h12l4 6-10 12L2 9z" fill="#150a40" stroke="#00f0ff" stroke-width=".8"/><path d="M2 9h20M9 3l-2 6 5 12 5-12-2-6" fill="none" stroke="#ff2bd6" stroke-width=".6"/></svg><p>Endless questions on every subject.<br>Win up to <b style="color:var(--y);text-shadow:0 0 10px var(--y)">${fmt(P[9])}</b></p><p style="opacity:.8;font-size:.9rem">Every 10 correct answers = 1 💎<br>Spend 1 💎 to unlock a hint</p><button class="btn" id="go">START GAME</button></div>`;
document.getElementById("go").onclick=start}
async function start(){A.innerHTML=head()+`<div class="c"><div class="sp"></div><p>Preparing fresh questions…</p></div>`;
 const qs=await take(10);g={qs,i:0};show();if(queue.length<10)fill()}
function show(){const q=g.qs[g.i];g.opts=sh([q[2],q[3],q[4],q[5]]);g.hint=false;g.done=false;g.left=T;
A.innerHTML=head()+`<div class="lad">${P.map((_,k)=>`<i class="${k<g.i?"d":k==g.i?"n":""}"></i>`).join("")}</div>
<div class="row"><div class="sub">${E(q[0])} • Question ${g.i+1}<b>${fmt(P[g.i])}</b></div><div class="ring"><svg viewBox="0 0 58 58"><circle cx="29" cy="29" r="25" fill="none" stroke="#2a1b5e" stroke-width="5"/><circle id="rc" cx="29" cy="29" r="25" fill="none" stroke="#00f0ff" stroke-width="5" stroke-linecap="round" stroke-dasharray="157" style="filter:drop-shadow(0 0 5px #00f0ff)"/></svg><span id="tn">${T}</span></div></div>
<div class="hx"><div class="q"><div>${E(q[1])}</div></div></div>
<div id="os">${g.opts.map((o,k)=>`<div class="hx"><button class="o" data-k="${k}"><div><b>${"ABCD"[k]}:</b>${E(o)}</div></button></div>`).join("")}</div>
<div id="h"></div><div class="msg" id="m"></div>
<div class="c"><button class="btn y" id="hb">💡 HINT (1 💎)</button></div>`;
document.querySelectorAll(".o").forEach(b=>b.onclick=()=>pick(+b.dataset.k));
document.getElementById("hb").onclick=hint;
clearInterval(g.tm);g.tm=setInterval(()=>{if(g.done)return;g.left-=.1;const r=Math.max(g.left,0);
 document.getElementById("tn").textContent=Math.ceil(r);const c=document.getElementById("rc");c.style.strokeDashoffset=157*(1-r/T);
 const col=r<8?"#ff3b3b":"#00f0ff";c.style.stroke=col;if(r<=0)pick(-1)},100)}
function hint(){if(g.done||g.hint)return;const m=document.getElementById("m");
 if(dia()<1){m.textContent="Not enough 💎! Answer 10 questions correctly to earn one.";return}
 spent++;S("sp",spent);g.hint=true;document.getElementById("h").innerHTML=`<div class="hint">💡 ${E(g.qs[g.i][6])}</div>`;upd();document.getElementById("hb").disabled=true}
function pick(k){if(g.done)return;g.done=true;clearInterval(g.tm);const q=g.qs[g.i],hs=document.querySelectorAll("#os .hx"),good=k>=0&&g.opts[k]===q[2];
 hs.forEach((h,j)=>{if(g.opts[j]===q[2])h.classList.add("ok")});
 if(good){tot++;S("tc",tot);upd();if(tot%10==0){boom();pop("💎 +1 DIAMOND!")}else pop("✅ CORRECT")
  setTimeout(()=>{g.i++;g.i>=10?end(10):show()},1400)}
 else{if(k>=0)hs[k].classList.add("no");else document.getElementById("m").textContent="⏰ Time up!";setTimeout(()=>end(g.i),1700)}}
function end(n){let win=0;SAFE.forEach(s=>{if(n>s)win=P[s]});if(n>=10)win=P[9];if(win)boom(n>=10?120:50);
 A.innerHTML=head()+`<div class="c"><h2 style="text-shadow:0 0 14px var(--m)">${n>=10?"🏆 JACKPOT!":"GAME OVER"}</h2><div class="big">${fmt(win)}</div><p>Correct this round: ${n}/10</p><button class="btn" id="again">PLAY AGAIN</button></div>`;
 document.getElementById("again").onclick=start}
home();
</script></body></html>
